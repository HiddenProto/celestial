{
  "outputDirectory": ".",
  "rewrites": [],
  "headers": [
    {
      "source": "/player.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *; default-src * 'unsafe-inline' 'unsafe-eval' blob: data:" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
